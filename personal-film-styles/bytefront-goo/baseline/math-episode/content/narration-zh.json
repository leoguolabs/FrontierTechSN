    },
    {
      "id": 3,
      "title": "多放一个开关会怎样"
    },
    {
      "id": 4,
      "title": "给开关加上规则"
    },
    {
      "id": 5,
      "title": "突破增长限制意味着什么"
    },
    {
      "id": 6,
      "title": "零就能推翻的一句话"
    },
    {
      "id": 7,
      "title": "让机器检查那套推理"
    },
    {
      "id": 8,
      "title": "为什么还要请数学家来看"
    },
    {
      "id": 9,
      "title": "原来的研究计划怎么改"
    },
    {
      "id": 10,
      "title": "拿到答案以后还能做什么"
    },
    {
      "id": 11,
      "title": "谁能用上工具继续研究"
    },
    {
      "id": 12,
      "title": "下次遇到突破新闻怎么读"
    }
  ],
